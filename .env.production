# ============================================================
# Bot Factory — Production Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values before deployment.
#   cp .env.production .env
# ============================================================

# ── Required: Session & Encryption ──────────────────────────
# HMAC_SECRET: Used for signing session tokens.
#   CRITICAL: Must be a stable hex string. If changed, all existing sessions are invalidated.
#   Generate: openssl rand -hex 32
HMAC_SECRET=

# ENCRYPTION_KEY: Used for encrypting sensitive bot credentials (BOT_TOKEN, API keys).
#   CRITICAL: Must be stable. If changed, previously encrypted data becomes unreadable!
#   Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# ── Required: Database ──────────────────────────────────────
# SQLite database path. Use an ABSOLUTE path in production for standalone mode.
# Example: file:/www/wwwroot/bot-factory/db/custom.db
DATABASE_URL="file:./db/custom.db"

# ── Recommended: Initial Admin Account ──────────────────────
# These are only used on first startup when NO accounts exist.
# After the first account is created, these are ignored.
# SECURITY: Leave empty for auto-generated random password (printed to console on startup).
# NEVER commit real credentials to version control!
ADMIN_INITIAL_USERNAME=
ADMIN_INITIAL_PASSWORD=

# ── Recommended: Server Origin (for CORS & WebSocket) ──────
# Your public URL, including protocol and port (if non-standard).
# Supports both HTTP and HTTPS deployments.
# Examples:
#   http://1.2.3.4:3000
#   https://botfactory.example.com
#   http://botfactory.example.com:8080
SERVER_ORIGIN=

# ── Optional: Bot Runner URL ───────────────────────────────
# Internal URL for the bot-runner microservice.
# Default: http://localhost:3001
# Change only if running in separate containers/hosts.
BOT_RUNNER_URL=http://localhost:3001

# ── Optional: Project Root ─────────────────────────────────
# Set this to the absolute path of the project root directory.
# Required for standalone mode where process.cwd() is .next/standalone/
# Example: /www/wwwroot/bot-factory
PROJECT_ROOT=
